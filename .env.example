# Telegram bot token from @BotFather
BOT_TOKEN=123456:replace-me
# Chat (user or group) id that receives escalated questions
ADMIN_CHAT_ID=0
# Anthropic API key. Not needed when MOCK_LLM=true
ANTHROPIC_API_KEY=
# Claude model id
CLAUDE_MODEL=claude-opus-5-5
# true = no API calls, a deterministic extractive answerer is used instead
MOCK_LLM=true
# Folder with the knowledge base (*.md)
DOCS_DIR=docs
# Minimum BM25 score of the best chunk before the LLM is asked at all
MIN_RETRIEVAL_SCORE=2.0
# Number of chunks sent to the LLM
TOP_K=3
# DEBUG, INFO, WARNING
LOG_LEVEL=INFO
